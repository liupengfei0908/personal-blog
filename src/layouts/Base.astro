---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  current?: string;
}

const { title, description = '个人博客', current = '' } = Astro.props;

const navItems = [
  { href: '/', label: '首页', key: 'home' },
  { href: '/about/', label: '关于我', key: 'about' },
  { href: '/works/', label: '作品集', key: 'works' },
  { href: '/blog/', label: '博客', key: 'blog' },
  { href: '/contact/', label: '联系', key: 'contact' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <!-- TODO: 替换为你的名字或网名 -->
        <a class="site-title" href="/">你的名字</a>
        <nav class="site-nav">
          {navItems.map((item) => (
            <a href={item.href} class={current === item.key ? 'active' : ''}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <!-- TODO: 替换版权年份与名字 -->
        © 2026 你的名字 · 由 Astro 构建
      </div>
    </footer>
  </body>
</html>
